//@version=6
indicator("ORB Breakout & Retest", overlay=true, max_lines_count=500)

// Runs at 5-min resolution. var variables persist across 5-min bars so the
// first candle's values are captured once and held for the rest of the session.
f_orb() =>
    var float h = na
    var float l = na
    var int   t = na
    if session.ismarket and not session.ismarket[1]  // first bar of session
        h := high
        l := low
        t := time
    if not session.ismarket and session.ismarket[1]  // session just ended
        h := na
        l := na
        t := na
    [h, l, t]

[orbH, orbL, orbT] = request.security("", "5", f_orb(), lookahead=barmerge.lookahead_off)

// 1-min OHLC for signal detection
c1 = request.security("", "1", close, lookahead=barmerge.lookahead_off)
h1 = request.security("", "1", high,  lookahead=barmerge.lookahead_off)
l1 = request.security("", "1", low,   lookahead=barmerge.lookahead_off)

// ORB lines (intraday only: 1, 2, 3, 5, 10, 15, 30-min, etc.)
var line lHigh = na
var line lLow  = na

if timeframe.isintraday
    newOrb     = not na(orbT) and na(orbT[1])   // ORB just appeared for a new session
    sessionEnd = na(orbT) and not na(orbT[1])   // session just ended

    if newOrb
        line.delete(lHigh)
        line.delete(lLow)
        lHigh := line.new(x1=int(orbT), y1=orbH, x2=int(orbT) + 60000, y2=orbH,
                     xloc=xloc.bar_time, extend=extend.right,
                     color=color.white, style=line.style_solid, width=1)
        lLow  := line.new(x1=int(orbT), y1=orbL, x2=int(orbT) + 60000, y2=orbL,
                     xloc=xloc.bar_time, extend=extend.right,
                     color=color.orange, style=line.style_solid, width=1)

    if sessionEnd
        line.delete(lHigh)
        line.delete(lLow)
        lHigh := na
        lLow  := na

// Signal state machines
// 0 = waiting for breakout  |  1 = breakout confirmed, watching for retest
var int buyState  = 0
var int sellState = 0

buySignal  = false
sellSignal = false

if timeframe.isintraday
    if (not na(orbT) and na(orbT[1])) or na(orbT)   // new session or no active ORB
        buyState  := 0
        sellState := 0

    // BUY: 1-min breaks above ORB high → price returns down to touch line → BUY
    if not na(orbH)
        if buyState == 0
            if c1 > orbH
                buyState := 1
        else if buyState == 1
            if l1 <= orbH
                buySignal := true
                buyState  := 0

    // SELL: 1-min breaks below ORB low → price returns up to touch line → SELL
    if not na(orbL)
        if sellState == 0
            if c1 < orbL
                sellState := 1
        else if sellState == 1
            if h1 >= orbL
                sellSignal := true
                sellState  := 0

// Plot signals
plotshape(buySignal,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.small)
plotshape(sellSignal, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.small)

//@version=5
indicator("ORB Breakout & Retest", overlay=true, max_lines_count=500)

// -- 5-min data (first candle of session + session events) --
high5         = request.security("", "5", high,                                            lookahead=barmerge.lookahead_off)
low5          = request.security("", "5", low,                                             lookahead=barmerge.lookahead_off)
time5         = request.security("", "5", time,                                            lookahead=barmerge.lookahead_off)
sessionOpen5  = request.security("", "5", session.ismarket and not session.ismarket[1],    lookahead=barmerge.lookahead_off)
sessionClose5 = request.security("", "5", not session.ismarket and session.ismarket[1],    lookahead=barmerge.lookahead_off)

// -- 1-min OHLC for retest/signal detection --
c1 = request.security("", "1", close, lookahead=barmerge.lookahead_off)
h1 = request.security("", "1", high,  lookahead=barmerge.lookahead_off)
l1 = request.security("", "1", low,   lookahead=barmerge.lookahead_off)

// -- ORB levels and lines (intraday only) --
var float orbH  = na
var float orbL  = na
var line  lHigh = na
var line  lLow  = na

if timeframe.isintraday
    if sessionOpen5
        orbH := high5
        orbL := low5
        line.delete(lHigh)
        line.delete(lLow)
        // Use bar_time so the line starts exactly at the 5-min candle open
        // regardless of the chart timeframe
        lHigh := line.new(x1=int(time5), y1=orbH, x2=int(time5) + 60000, y2=orbH,
                     xloc=xloc.bar_time, extend=extend.right,
                     color=color.white, style=line.style_solid, width=1)
        lLow  := line.new(x1=int(time5), y1=orbL, x2=int(time5) + 60000, y2=orbL,
                     xloc=xloc.bar_time, extend=extend.right,
                     color=color.orange, style=line.style_solid, width=1)

    if sessionClose5
        line.delete(lHigh)
        line.delete(lLow)
        lHigh := na
        lLow  := na
        orbH  := na
        orbL  := na

// -- Signal state machines --
// States: 0 = waiting for breakout, 1 = breakout confirmed (watching for retest)
var int buyState  = 0
var int sellState = 0

buySignal  = false
sellSignal = false

if timeframe.isintraday
    if sessionOpen5
        buyState  := 0
        sellState := 0

    // BUY: 1-min breaks above ORB high, then retests and closes above it
    if not na(orbH)
        if buyState == 0
            if c1 > orbH
                buyState := 1
        else if buyState == 1
            if l1 <= orbH
                if c1 > orbH
                    buySignal := true
                buyState := 0

    // SELL: 1-min breaks below ORB low, then retests and closes below it
    if not na(orbL)
        if sellState == 0
            if c1 < orbL
                sellState := 1
        else if sellState == 1
            if h1 >= orbL
                if c1 < orbL
                    sellSignal := true
                sellState := 0

// -- Plot signals --
plotshape(buySignal,  title="BUY",  location=location.belowbar, style=shape.triangleup,   color=color.lime, size=size.normal)
plotshape(sellSignal, title="SELL", location=location.abovebar, style=shape.triangledown, color=color.red,  size=size.normal)
